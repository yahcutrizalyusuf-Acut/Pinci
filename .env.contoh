# Salin menjadi .env lalu isi. Jangan unggah .env ke GitHub.
# lokal = data hanya di HP (bawaan). supabase = kirim ke server.
EXPO_PUBLIC_DATA_MODE=lokal
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Tanggal isi TKA dibuka. Isi "mati" untuk membuka sekarang (uji).
EXPO_PUBLIC_TKA_BUKA=2027-01-04
# "nyala" untuk menampilkan Kelola guru (Rilis 3).
EXPO_PUBLIC_FITUR_GURU=
